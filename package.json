{
    "name": "dhis2-blocks",
    "version": "1.0.0",
    "private": true,
    "description": "Reusable DHIS2 UI blocks and their development applications",
    "license": "BSD-3-Clause",
    "scripts": {
        "build": "turbo run build --filter=@dhis2-blocks/web",
        "start": "turbo run start --filter=@dhis2-blocks/web",
        "test": "pnpm test:lint-rules && turbo run test",
        "typecheck": "pnpm typecheck:lint-rules && turbo run typecheck",
        "deploy": "turbo run deploy --filter=@dhis2-blocks/web",
        "dead-code:audit": "knip",
        "lint": "pnpm lint:stylesheets && oxlint --deny-warnings . && oxfmt --check .",
        "audit:exports": "knip --exports",
        "format": "oxfmt --write .",
        "e2e": "bash scripts/e2e/run-version.sh dev",
        "e2e:41": "bash scripts/e2e/run-version.sh 41",
        "e2e:42": "bash scripts/e2e/run-version.sh 42",
        "e2e:43": "bash scripts/e2e/run-version.sh 43",
        "e2e:dev": "bash scripts/e2e/run-version.sh dev",
        "e2e:validate": "bash scripts/e2e/validate.sh",
        "e2e:up": "bash scripts/e2e/up.sh",
        "e2e:down": "bash scripts/e2e/down.sh",
        "test:lint-rules": "node tools/oxlint/test.mjs",
        "typecheck:lint-rules": "tsc --project tools/oxlint/anti-slop/tsconfig.json --noEmit && tsc --project tools/oxlint/tsconfig.json --noEmit",
        "lint:stylesheets": "node tools/oxlint/check-stylesheets.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@oxlint/plugins": "1.79.0",
        "@playwright/test": "^1.62.1",
        "@types/node": "^22.20.1",
        "knip": "6.32.2",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "turbo": "^2.10.10",
        "typescript": "^5.9.3",
        "zod": "^4.4.3"
    },
    "packageManager": "pnpm@10.13.1"
}

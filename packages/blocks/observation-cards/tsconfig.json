{
    "compilerOptions": {
        "strict": true,
        "skipLibCheck": true,
        "allowJs": false,
        "jsx": "react",
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "esnext",
        "moduleResolution": "node",
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@/registry/dhis2/ui/*": ["../ui/src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}

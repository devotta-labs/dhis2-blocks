# DHIS2 backend the same-origin /dhis2 proxy forwards to.
# Default matches the seeded local stack from `pnpm docs:up`.
DOCS_DHIS2_URL=http://127.0.0.1:58080

# Port for `vite dev`, `vite preview`, and the production server (server.mjs).
DOCS_PORT=3002

# Optional demo credentials injected into every proxied request so live
# previews load authenticated without any sign-in flow (admin/district is
# the published demo account on seeded and play instances). Unset them to
# pass requests anonymously and show the adapter's sign-in dialog instead.
DOCS_DHIS2_USERNAME=admin
DOCS_DHIS2_PASSWORD=district

{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "include": [
        "files",
        "dependencies",
        "unlisted",
        "binaries",
        "unresolved",
        "exports",
        "nsExports",
        "types",
        "nsTypes",
        "enumMembers",
        "namespaceMembers",
        "duplicates",
        "catalog",
        "catalogReferences",
        "cycles"
    ],
    "rules": {
        "binaries": "error",
        "catalog": "error",
        "catalogReferences": "error",
        "cycles": "error",
        "dependencies": "error",
        "devDependencies": "error",
        "duplicates": "error",
        "enumMembers": "error",
        "exports": "error",
        "files": "error",
        "namespaceMembers": "error",
        "nsExports": "error",
        "nsTypes": "error",
        "optionalPeerDependencies": "error",
        "types": "error",
        "unlisted": "error",
        "unresolved": "error"
    },
    "treatConfigHintsAsErrors": true,
    "treatTagHintsAsErrors": true,
    "workspaces": {
        ".": {
            "entry": ["e2e/specs/**/*.spec.ts"],
            "ignore": ["tools/registry/consumer/**"],
            "project": [
                "e2e/**/*.ts",
                "tools/**/*.ts",
                "*.config.{js,mjs,cjs,ts,mts,cts}"
            ]
        },
        "apps/web": {
            "entry": [
                "d2.config.js",
                "src/AppWrapper.tsx",
                "src/workingListTranslationCatalog.ts",
                "src/**/*.{test,spec}.{ts,tsx}",
                "src/**/__tests__/**/*.{ts,tsx}"
            ],
            "project": ["src/**/*.{ts,tsx,css}"],
            "includeEntryExports": true,
            "ignoreIssues": {
                "d2.config.js": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "src/AppWrapper.tsx": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "src/workingListTranslationCatalog.ts": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        },
        "packages/blocks/*": {
            "entry": [
                "src/**/*.{test,spec}.{ts,tsx}",
                "src/**/__tests__/**/*.{ts,tsx}",
                "type-tests/**/*.ts"
            ],
            "project": [
                "src/**/*.{ts,tsx,css}",
                "test/**/*.{ts,css}",
                "type-tests/**/*.ts"
            ],
            "includeEntryExports": true,
            "ignoreDependencies": ["@dhis2-blocks/ui"],
            "ignoreIssues": {
                "src/index.ts": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "test/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "type-tests/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        },
        "packages/blocks/ui": {
            "entry": ["src/*.{ts,tsx}"],
            "project": ["src/**/*.{ts,tsx,css}", "test/**/*.{ts,css}"],
            "includeEntryExports": false,
            "ignoreIssues": {
                "test/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        },
        "packages/blocks/context-selector": {
            "entry": [
                "src/**/*.{test,spec}.{ts,tsx}",
                "src/**/__tests__/**/*.{ts,tsx}",
                "type-tests/**/*.ts"
            ],
            "project": [
                "src/**/*.{ts,tsx}",
                "test/**/*.{ts,css}",
                "type-tests/**/*.ts"
            ],
            "includeEntryExports": true,
            "ignoreIssues": {
                "src/index.ts": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "test/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "type-tests/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        },
        "packages/blocks/event-form": {
            "entry": ["src/**/*.test.{ts,tsx}", "type-tests/**/*.ts"],
            "project": [
                "src/**/*.{ts,tsx}",
                "test/**/*.{ts,css}",
                "type-tests/**/*.ts"
            ],
            "includeEntryExports": true,
            "ignoreDependencies": [
                "@dhis2-blocks/ui",
                "@dhis2-blocks/program-rules"
            ],
            "ignoreIssues": {
                "test/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "type-tests/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        },
        "packages/blocks/program-rules": {
            "entry": ["src/**/*.test.{ts,tsx}", "type-tests/**/*.ts"],
            "project": [
                "src/**/*.{ts,tsx}",
                "test/**/*.ts",
                "type-tests/**/*.ts"
            ],
            "includeEntryExports": true,
            "ignoreIssues": {
                "test/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "type-tests/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        }
    }
}

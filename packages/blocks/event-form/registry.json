{
    "$schema": "https://ui.shadcn.com/schema/registry.json",
    "items": [
        {
            "name": "event-form",
            "type": "registry:block",
            "title": "DHIS2 Event Form",
            "description": "Create and edit a tracker event for one program stage, with program rules applied.",
            "dependencies": [
                "@dhis2/app-runtime@^3.15.1",
                "@tanstack/react-query@^5.101.4",
                "better-result@^3.0.1",
                "zod@^4.4.3",
                "zustand@^5.0.15"
            ],
            "registryDependencies": [
                "devotta-labs/dhis2-blocks/use-program-rules"
            ],
            "files": [
                {
                    "path": "src/api/client.ts",
                    "type": "registry:file",
                    "target": "@components/event-form/api/client.ts"
                },
                {
                    "path": "src/api/hooks.ts",
                    "type": "registry:file",
                    "target": "@components/event-form/api/hooks.ts"
                },
                {
                    "path": "src/api/queries.ts",
                    "type": "registry:file",
                    "target": "@components/event-form/api/queries.ts"
                },
                {
                    "path": "src/api/runtimeClient.ts",
                    "type": "registry:file",
                    "target": "@components/event-form/api/runtimeClient.ts"
                },
                {
                    "path": "src/api/schemas.ts",
                    "type": "registry:file",
                    "target": "@components/event-form/api/schemas.ts"
                }
            ]
        }
    ]
}

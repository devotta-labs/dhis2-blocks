{
    "$schema": "https://turborepo.dev/schema.json",
    "cacheDir": ".turbo/cache",
    "tasks": {
        "build": {
            "outputs": ["build/**", ".d2/**", "src/locales/**"]
        },
        "test": {
            "dependsOn": ["^test"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/registry/manifest.ts"
            ],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/registry/manifest.ts"
            ],
            "outputs": []
        },
        "lint": {
            "outputs": []
        },
        "start": {
            "cache": false,
            "persistent": true
        },
        "deploy": {
            "dependsOn": ["build"],
            "cache": false
        }
    }
}

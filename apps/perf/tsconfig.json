{
    "compilerOptions": {
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "baseUrl": ".",
        "paths": {
            "@/components/dhis2/ui/*": ["../../packages/registry/components/*"],
            "@/components/*": ["../../packages/registry/blocks/*"]
        },
        "types": ["node"]
    },
    "include": ["src", "bench"]
}

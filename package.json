{
    "name": "dhis2-blocks",
    "version": "1.0.0",
    "description": "Reusable DHIS2 UI blocks and their development applications",
    "license": "BSD-3-Clause",
    "private": true,
    "packageManager": "pnpm@10.13.1",
    "scripts": {
        "build": "turbo run build",
        "build:library": "turbo run build --filter=@dhis2-blocks/working-list",
        "package:check": "turbo run package:check --filter=@dhis2-blocks/working-list",
        "start": "turbo run start --filter=@dhis2-blocks/web",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "deploy": "turbo run deploy --filter=@dhis2-blocks/web",
        "lint": "turbo run lint && prettier -c .",
        "format": "prettier . -w",
        "e2e": "bash scripts/e2e/run-version.sh dev",
        "e2e:41": "bash scripts/e2e/run-version.sh 41",
        "e2e:42": "bash scripts/e2e/run-version.sh 42",
        "e2e:43": "bash scripts/e2e/run-version.sh 43",
        "e2e:dev": "bash scripts/e2e/run-version.sh dev",
        "e2e:validate": "bash scripts/e2e/validate.sh",
        "e2e:up": "bash scripts/e2e/up.sh",
        "e2e:down": "bash scripts/e2e/down.sh"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@dhis2/config-eslint": "^0.2.2",
        "@dhis2/config-prettier": "^0.2.2",
        "@eslint/compat": "^2.0.0",
        "@playwright/test": "^1.62.1",
        "eslint": "^9.39.2",
        "prettier": "^3.7.4",
        "turbo": "^2.10.10",
        "typescript": "^5.9.3"
    }
}

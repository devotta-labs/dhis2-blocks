{
    "$schema": "https://turborepo.dev/schema.json",
    "cacheDir": ".turbo/cache",
    "globalDependencies": [
        "tsconfig*.json",
        "pnpm-workspace.yaml",
        "patches/**"
    ],
    "globalEnv": ["CI"],
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"]
        },
        "build": {
            "dependsOn": ["^transit"],
            "env": [
                "NODE_ENV",
                "PUBLIC_URL",
                "DHIS2_BASE_URL",
                "REACT_APP_*",
                "VITE_*",
                "DOCS_*"
            ],
            "outputs": ["build/**", "dist/**", ".d2/**", "src/locales/**"]
        },
        "test": {
            "dependsOn": ["^transit"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/registry/manifest.ts"
            ],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^transit"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/registry/manifest.ts"
            ],
            "outputs": []
        },
        "lint": {
            "outputs": []
        },
        "start": {
            "cache": false,
            "persistent": true
        },
        "deploy": {
            "dependsOn": ["build"],
            "cache": false
        }
    }
}

@@ -0,0 +1,49 @@
+package org.hisp.dhis.lib.expression
+
+import org.hisp.dhis.lib.expression.spi.ExpressionData
+import org.hisp.dhis.lib.expression.spi.ValueType
+import org.hisp.dhis.lib.expression.spi.VariableValue
+import kotlin.test.*
+
+class CustomFunctionTest {
+    private fun expression(source: String) = Expression(source, ExpressionMode.RULE_ENGINE_ACTION)
+
+    @Test fun evaluatesNamedPropsAndCollectsDependencies() {
+        val source = expression("custom:number('lookup', {code: #{test}, multiplier: 2 + 1})")
+        assertEquals(setOf("test"), source.collectProgramRuleVariableNames())
+        val data = ExpressionData(mapOf("test" to VariableValue(ValueType.STRING, "HB", emptyList(), null)), emptyMap(), emptyMap(), emptyMap(), emptyMap())
+        assertEquals(24, source.evaluateCustom({ type, name, props ->
+            assertEquals("number", type)
+            assertEquals("lookup", name)
+            assertEquals(mapOf("code" to "HB", "multiplier" to 3.0), props)
+            24
+        }, data))
+    }
+
+    @Test fun propertyOrderAndNormalisationDoNotChangeMeaning() {
+        val first = expression("custom:string('lookup', {a: 'A', b: true})")
+        val second = expression("custom:string('lookup', {'b': true, 'a': 'A',})")
+        val callback: (String, String, Map<String, Any?>) -> Any? = { _, _, props -> props["a"] }
+        assertEquals("A", first.evaluateCustom(callback, ExpressionData()))
+        assertEquals("A", second.evaluateCustom(callback, ExpressionData()))
+        assertEquals("A", expression(first.normalise()).evaluateCustom(callback, ExpressionData()))
+    }
+
+    @Test fun rejectsDuplicateUnsafeAndNonObjectProps() {
+        for (source in listOf(
+            "custom:number('x', {a: 1, a: 2})",
+            "custom:number('x', {a: 1, 'a': 2})",
+            "custom:number('x', {__proto__: 1})",
+            "custom:number('x', 'a', 1)",
+            "custom:number('x', {nested: {a: 1}})",
+            "custom:number('x', {items: [1, 2]})"
+        )) assertFails(source) { expression(source) }
+    }
+
+    @Test fun acceptsNullableScalarsButRejectsWrongReturnTypes() {
+        assertNull(expression("custom:number('x', {})").evaluateCustom({ _, _, _ -> null }, ExpressionData()))
+        assertEquals(false, expression("custom:boolean('x', {})").evaluateCustom({ _, _, _ -> false }, ExpressionData()))
+        assertFails { expression("custom:number('x', {})").evaluateCustom({ _, _, _ -> "12" }, ExpressionData()) }
+        assertFails { expression("custom:number('x', {})").evaluateCustom({ _, _, _ -> Double.NaN }, ExpressionData()) }
+    }
+}

{
    "name": "@dhis2-blocks/docs",
    "version": "1.0.0",
    "private": true,
    "description": "Documentation site for DHIS2 Blocks",
    "license": "BSD-3-Clause",
    "type": "module",
    "scripts": {
        "build": "pnpm registry:build && next build",
        "lint": "oxlint --deny-warnings app components lib tests",
        "registry:build": "shadcn build registry.json --cwd ../.. --output apps/docs/public/r",
        "dev": "portless blocks next dev",
        "test": "vitest run",
        "typecheck": "next typegen && tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@dhis2-blocks/context-selector": "workspace:*",
        "@dhis2-blocks/working-list": "workspace:*",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fumadocs-core": "^16.15.4",
        "fumadocs-mdx": "^15.4.0",
        "fumadocs-ui": "^16.15.4",
        "geist": "^1.7.2",
        "lucide-react": "^1.37.0",
        "next": "16.3.3",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "shadcn": "^4.19.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/mdx": "^2.0.14",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "4.1.11"
    }
}

{
    "name": "@dhis2-blocks/working-list",
    "version": "1.0.0",
    "private": true,
    "description": "Reusable DHIS2 Working List component",
    "license": "BSD-3-Clause",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./development": "./src/development.ts"
    },
    "scripts": {
        "test": "d2-app-scripts test",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --deny-warnings src"
    },
    "dependencies": {
        "@dhis2/app-runtime": "^3.15.1",
        "@dhis2/d2-i18n": "1.2.0",
        "@dhis2/multi-calendar-dates": "2.1.2",
        "@dhis2/ui": "^10.17.0",
        "@dhis2/ui-icons": "^10.17.0",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-table": "^9.1.2",
        "better-result": "^3.0.1",
        "zod": "^4.4.3",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@dhis2/cli-app-scripts": "12.10.3",
        "@tanstack/table-core": "9.1.2",
        "@types/jest": "^30.0.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "jest": {
        "moduleNameMapper": {
            "\\.(css|less)$": "<rootDir>/test/styleMock.ts",
            "^better-result$": "<rootDir>/test/betterResultMock.ts",
            "^@tanstack/table-core/(.*)$": "<rootDir>/node_modules/@tanstack/react-table/../table-core/dist/$1.js"
        },
        "setupFilesAfterEnv": [
            "<rootDir>/test/setup.ts"
        ],
        "transformIgnorePatterns": [
            "/node_modules/(?!\\.pnpm/(?:@tanstack\\+|better-result@)|@tanstack/|better-result/)"
        ],
        "watchman": false
    }
}

{
    "name": "@dhis2-blocks/working-list",
    "version": "1.0.0",
    "private": true,
    "description": "Reusable DHIS2 Working List component",
    "license": "BSD-3-Clause",
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vite build && tsc",
        "start": "concurrently -n build,types --hide types \"vite build --watch --mode development\" \"tsc --watch --preserveWatchOutput\"",
        "package:check": "npm pack --dry-run --cache .npm-cache",
        "test": "d2-app-scripts test",
        "typecheck": "tsc --noEmit --emitDeclarationOnly false",
        "lint": "oxlint --deny-warnings src"
    },
    "dependencies": {
        "@dhis2/d2-i18n": "1.2.0",
        "@dhis2/multi-calendar-dates": "2.1.2",
        "@dhis2/ui": "^10.11.0",
        "@dhis2/ui-icons": "^10.11.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-table": "^9.1.2",
        "zod": "^4.4.3",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@dhis2/cli-app-scripts": "12.10.3",
        "@tanstack/table-core": "9.1.2",
        "@types/jest": "^30.0.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vite-plugin-lib-inject-css": "2.2.2"
    },
    "peerDependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "jest": {
        "moduleNameMapper": {
            "\\.(css|less)$": "<rootDir>/test/styleMock.ts",
            "^@tanstack/table-core/(.*)$": "<rootDir>/node_modules/@tanstack/react-table/../table-core/dist/$1.js"
        },
        "transformIgnorePatterns": [
            "/node_modules/(?!\\.pnpm/@tanstack\\+|@tanstack/)"
        ],
        "watchman": false
    }
}

{
    "compilerOptions": {
        "strict": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "resolveJsonModule": true,
        "paths": {
            "@/components/dhis2/ui/*": ["./components/*"],
            "@/components/*": ["./blocks/*"]
        },
        "types": ["node", "vitest/globals"]
    },
    "include": ["components", "blocks", "test"]
}

{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "include": [
        "files",
        "dependencies",
        "unlisted",
        "binaries",
        "unresolved",
        "exports",
        "nsExports",
        "types",
        "nsTypes",
        "enumMembers",
        "namespaceMembers",
        "duplicates",
        "catalog",
        "catalogReferences",
        "cycles"
    ],
    "rules": {
        "binaries": "error",
        "catalog": "error",
        "catalogReferences": "error",
        "cycles": "error",
        "dependencies": "error",
        "devDependencies": "error",
        "duplicates": "error",
        "enumMembers": "error",
        "exports": "error",
        "files": "error",
        "namespaceMembers": "error",
        "nsExports": "error",
        "nsTypes": "error",
        "optionalPeerDependencies": "error",
        "types": "error",
        "unlisted": "error",
        "unresolved": "error"
    },
    "treatConfigHintsAsErrors": true,
    "treatTagHintsAsErrors": true,
    "workspaces": {
        ".": {
            "entry": [
                "e2e/specs/**/*.spec.ts",
                "e2e/specs-docs/**/*.spec.ts",
                "playwright.docs.config.ts"
            ],
            "ignore": ["tools/registry/consumer/**"],
            "project": [
                "e2e/**/*.ts",
                "tools/**/*.ts",
                "*.config.{js,mjs,cjs,ts,mts,cts}"
            ]
        },
        "apps/web": {
            "entry": [
                "d2.config.js",
                "src/AppWrapper.tsx",
                "src/workingListTranslationCatalog.ts",
                "src/sidebarTranslationCatalog.ts",
                "src/dataEntryTranslationCatalog.ts",
                "src/trackedEntityFinderTranslationCatalog.ts",
                "src/**/*.{test,spec}.{ts,tsx}",
                "src/**/__tests__/**/*.{ts,tsx}"
            ],
            "project": ["src/**/*.{ts,tsx,css}"],
            "includeEntryExports": true,
            "ignoreIssues": {
                "d2.config.js": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "src/AppWrapper.tsx": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "src/workingListTranslationCatalog.ts": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "src/sidebarTranslationCatalog.ts": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "src/dataEntryTranslationCatalog.ts": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "src/trackedEntityFinderTranslationCatalog.ts": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        },
        "apps/perf": {
            "entry": [
                "d2.config.js",
                "src/App.tsx",
                "bench/{serve,run,report,hotspots}.mts"
            ],
            "project": ["src/**/*.{ts,tsx,css}", "bench/**/*.mts"],
            "ignoreDependencies": [
                "@dhis2/app-runtime",
                "@dhis2/d2-i18n",
                "@dhis2/ui"
            ],
            "ignoreIssues": {
                "d2.config.js": ["exports"],
                "src/App.tsx": ["exports"]
            }
        },
        "apps/docs": {
            "entry": ["server/**/*.test.mjs"],
            "ignoreDependencies": ["typeface-roboto"],
            "project": [
                "src/**/*.{ts,tsx,css}",
                "server/**/*.mjs",
                "*.config.ts",
                "*.mjs",
                "src/**/*.mdx"
            ],
            "ignoreIssues": {
                "src/components/ExampleCard.tsx": ["exports"],
                "src/components/InstallCommand.tsx": ["exports"],
                "src/components/ui/**": ["exports"],
                "src/lib/highlighter.tsx": ["exports"]
            }
        },
        "packages/registry": {
            "entry": [
                "components/*.{ts,tsx}",
                "blocks/*/index.ts",
                "blocks/timeline/dhis2/index.ts",
                "**/*.{test,spec}.{ts,tsx}",
                "**/__tests__/**/*.{ts,tsx}"
            ],
            "project": [
                "components/**/*.{ts,tsx,css}",
                "blocks/**/*.{ts,tsx,css}",
                "test/**/*.{ts,css}"
            ],
            "ignoreDependencies": ["prop-types"],
            "ignoreIssues": {
                "test/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        }
    }
}

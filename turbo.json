{
    "$schema": "https://turborepo.dev/schema.json",
    "cacheDir": ".turbo/cache",
    "tasks": {
        "build": {
            "outputs": [
                "build/**",
                "dist/**",
                ".d2/**",
                ".next/**",
                "public/r/**",
                "src/locales/**"
            ]
        },
        "test": {
            "outputs": []
        },
        "typecheck": {
            "outputs": []
        },
        "lint": {
            "outputs": []
        },
        "start": {
            "cache": false,
            "persistent": true
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "deploy": {
            "dependsOn": ["build"],
            "cache": false
        }
    }
}

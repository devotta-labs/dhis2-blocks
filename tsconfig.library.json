{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmit": false,
        "outDir": "dist/working-list",
        "rootDir": "src/working-list"
    },
    "include": ["src/working-list/**/*.ts", "src/working-list/**/*.tsx"],
    "exclude": [
        "src/working-list/**/*.test.ts",
        "src/working-list/**/*.test.tsx"
    ]
}

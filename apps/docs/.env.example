# DHIS2 backend the same-origin /dhis2 proxy forwards to.
# Default matches the seeded local stack from `pnpm docs:up`.
DOCS_DHIS2_URL=http://127.0.0.1:58080

# Port for `vite dev`, `vite preview`, and the production server (server.mjs).
DOCS_PORT=3002

# Credentials injected into every proxied request so live previews always
# show an active session. They default to the published demo account
# (admin/district on every seeded and play instance) — only set these to
# point at a different account.
# DOCS_DHIS2_USERNAME=admin
# DOCS_DHIS2_PASSWORD=district

# Set to pass requests anonymously and show the adapter's sign-in dialog
# instead of injecting credentials.
# DOCS_DHIS2_ANONYMOUS=1

{
    "name": "@dhis2-blocks/web",
    "version": "1.0.0",
    "private": true,
    "description": "DHIS2 wrapper application for developing Working List blocks",
    "license": "BSD-3-Clause",
    "scripts": {
        "build": "d2-app-scripts build",
        "start": "d2-app-scripts start",
        "test": "d2-app-scripts test",
        "typecheck": "tsc --noEmit",
        "deploy": "d2-app-scripts deploy",
        "lint": "oxlint --deny-warnings src"
    },
    "dependencies": {
        "@dhis2-blocks/working-list": "workspace:*",
        "@dhis2/app-runtime": "^3.15.1",
        "@dhis2/d2-i18n": "1.2.0",
        "@dhis2/ui": "^10.17.0",
        "@tanstack/react-query": "^5.101.4",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router-dom": "^7.18.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@dhis2/cli-app-scripts": "12.10.3",
        "@tailwindcss/vite": "^4.3.3",
        "@types/jest": "^30.0.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.0"
    },
    "jest": {
        "moduleNameMapper": {
            "\\.(css|less)$": "<rootDir>/../../packages/working-list/test/styleMock.ts",
            "^better-result$": "<rootDir>/../../packages/working-list/test/betterResultMock.ts",
            "^@tanstack/table-core/(.*)$": "<rootDir>/../../packages/working-list/node_modules/@tanstack/react-table/../table-core/dist/$1.js"
        },
        "transformIgnorePatterns": [
            "/node_modules/(?!\\.pnpm/(?:@tanstack\\+)|@tanstack/)"
        ],
        "watchman": false
    }
}

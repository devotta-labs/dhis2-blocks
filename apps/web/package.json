{
    "name": "@dhis2-blocks/web",
    "version": "1.0.0",
    "private": true,
    "description": "DHIS2 wrapper application for developing Working List blocks",
    "license": "BSD-3-Clause",
    "scripts": {
        "build": "d2-app-scripts build",
        "start": "d2-app-scripts start",
        "test": "vitest run",
        "test:browser": "vitest run --project browser",
        "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
        "deploy": "d2-app-scripts deploy",
        "lint": "oxlint --deny-warnings src"
    },
    "dependencies": {
        "@dhis2-blocks/context-selector": "workspace:*",
        "@dhis2-blocks/working-list": "workspace:*",
        "@dhis2/app-runtime": "^3.15.1",
        "@dhis2/d2-i18n": "1.2.0",
        "@dhis2/ui": "^10.17.0",
        "@dhis2/ui-icons": "^10.17.0",
        "@tanstack/react-query": "^5.101.4",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router-dom": "^7.18.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@dhis2/cli-app-scripts": "12.10.3",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitest/browser-playwright": "4.1.11",
        "playwright": "1.62.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vitest": "4.1.11",
        "vitest-browser-react": "2.2.0"
    }

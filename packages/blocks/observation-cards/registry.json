                },
                {
                    "path": "src/cards/RecordedNote.tsx",
                    "type": "registry:file",
                    "target": "@components/observation-cards/cards/RecordedNote.tsx"
                },
                {
                    "path": "src/cards/Sparkline.tsx",
                    "type": "registry:file",
                    "target": "@components/observation-cards/cards/Sparkline.tsx"
                },
                {
                    "path": "src/cards/TrendCard.tsx",
                    "type": "registry:file",
                    "target": "@components/observation-cards/cards/TrendCard.tsx"
                },
                {
                    "path": "src/cards/calendar.ts",
                    "type": "registry:file",
                    "target": "@components/observation-cards/cards/calendar.ts"
                },
                {
                    "path": "src/cards/format.ts",
                    "type": "registry:file",
                    "target": "@components/observation-cards/cards/format.ts"
                }
            ],
            "docs": "Call useTrackedEntityObservations once and pass observations.get(dataElementId) to each card as its observation prop. Render beneath the DHIS2 app-runtime and TanStack Query providers."
        }
    ]
}

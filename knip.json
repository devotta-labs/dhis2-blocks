{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "rules": {
        "binaries": "off",
        "catalog": "off",
        "dependencies": "off",
        "devDependencies": "off",
        "duplicates": "off",
        "enumMembers": "warn",
        "exports": "warn",
        "files": "off",
        "namespaceMembers": "warn",
        "nsExports": "warn",
        "nsTypes": "warn",
        "optionalPeerDependencies": "off",
        "types": "warn",
        "unlisted": "off",
        "unresolved": "off"
    },
    "treatConfigHintsAsErrors": true,
    "workspaces": {
        ".": {
            "entry": ["e2e/specs/**/*.spec.ts"],
            "project": [
                "e2e/**/*.ts",
                "scripts/**/*.{js,mjs,cjs,ts,mts,cts}",
                "tools/**/*.ts",
                "*.config.{js,mjs,cjs,ts,mts,cts}"
            ]
        },
        "apps/web": {
            "entry": [
                "d2.config.js",
                "src/AppWrapper.tsx",
                "src/workingListTranslationCatalog.ts",
                "src/**/*.{test,spec}.{ts,tsx}",
                "src/**/__tests__/**/*.{ts,tsx}"
            ],
            "project": ["src/**/*.{ts,tsx,css}"],
            "includeEntryExports": true,
            "ignoreIssues": {
                "src/AppWrapper.tsx": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        },
        "packages/*": {
            "entry": [
                "src/**/*.{test,spec}.{ts,tsx}",
                "src/**/__tests__/**/*.{ts,tsx}",
                "test/{betterResultMock,setup,styleMock}.ts",
                "type-tests/**/*.ts"
            ],
            "project": [
                "src/**/*.{ts,tsx}",
                "test/**/*.ts",
                "type-tests/**/*.ts"
            ],
            "includeEntryExports": true,
            "ignoreIssues": {
                "src/index.ts": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "test/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ],
                "type-tests/**": [
                    "exports",
                    "types",
                    "nsExports",
                    "nsTypes",
                    "enumMembers",
                    "namespaceMembers"
                ]
            }
        }
    }
}

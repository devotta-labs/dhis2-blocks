{
    "$schema": "https://turborepo.dev/schema.json",
    "cacheDir": ".turbo/cache",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["build/**", "dist/**", ".d2/**", "src/locales/**"]
        },
        "transit": {
            "dependsOn": ["^transit"]
        },
        "test": {
            "dependsOn": ["transit"],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["transit"],
            "outputs": []
        },
        "lint": {
            "outputs": []
        },
        "//#typecheck:registry": {
            "outputs": []
        },
        "start": {
            "cache": false,
            "persistent": true
        },
        "deploy": {
            "dependsOn": ["build"],
            "cache": false
        }
    }
}

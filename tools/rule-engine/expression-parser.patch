+++ b/src/commonMain/kotlin/org/hisp/dhis/lib/expression/syntax/CustomProps.kt
@@ -0,0 +1,42 @@
+package org.hisp.dhis.lib.expression.syntax
+
+import org.hisp.dhis.lib.expression.ast.NodeType
+import org.hisp.dhis.lib.expression.ast.Nodes.Utf8StringNode
+
+/** Object literals are restricted to the props argument of custom dispatchers. */
+internal object CustomProps : Fragment {
+    override fun parse(expr: Expr, ctx: ParseContext) {
+        val start = expr.marker()
+        expr.expect('{')
+        ctx.beginNode(NodeType.FUNCTION, start, "custom:props")
+        expr.skipWS()
+        val keys = mutableSetOf<String>()
+        var index = 0
+        while (expr.peek() != '}') {
+            val keyStart = expr.marker()
+            val quoted = expr.peek() == '\'' || expr.peek() == '"'
+            if (!quoted && !(expr.peek().isLetter() || expr.peek() == '_')) {
+                expr.error("Expected a property name")
+            }
+            val rawKey = if (quoted) Literals.parseString(expr) else Literals.parseIdentifier(expr)
+            val key = Utf8StringNode.decode(rawKey)
+            if (!keys.add(key)) expr.error("Duplicate property: $key")
+            if (key in setOf("__proto__", "constructor", "prototype")) expr.error("Unsafe property: $key")
+            ctx.beginNode(NodeType.ARGUMENT, keyStart, (index++).toString())
+            ctx.addNode(NodeType.STRING, keyStart, rawKey)
+            ctx.endNode(NodeType.ARGUMENT, expr.marker())
+            expr.skipWS()
+            expr.expect(':')
+            expr.skipWS()
+            ctx.beginNode(NodeType.ARGUMENT, expr.marker(), (index++).toString())
+            Expr.expr(expr, ctx)
+            ctx.endNode(NodeType.ARGUMENT, expr.marker())
+            expr.skipWS()
+            if (expr.peek() == '}') break
+            expr.expect(',')
+            expr.skipWS()
+        }
+        expr.expect('}')
+        ctx.endNode(NodeType.FUNCTION, expr.marker())
+    }
+}

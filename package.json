{
    "name": "dhis2-blocks",
    "version": "1.0.0",
    "private": true,
    "description": "Reusable DHIS2 UI blocks and their development applications",
    "license": "BSD-3-Clause",
    "scripts": {
        "build": "turbo run build --filter=@dhis2-blocks/web",
        "start": "turbo run start --filter=@dhis2-blocks/web",
        "test": "pnpm test:registry && turbo run test",
        "test:registry": "node --experimental-strip-types --test tools/registry/*.test.ts",
        "typecheck": "turbo run typecheck && tsc --project tools/registry",
        "deploy": "turbo run deploy --filter=@dhis2-blocks/web",
        "dead-code:audit": "knip",
        "lint": "oxlint --deny-warnings . && oxfmt --check .",
        "audit:exports": "knip --exports",
        "registry:validate": "shadcn registry validate",
        "registry:build": "shadcn build --output dist/registry",
        "registry:check": "pnpm registry:validate && node --experimental-strip-types tools/registry/installCheck.ts",
        "format": "oxfmt --write .",
        "e2e": "bash scripts/e2e/run-version.sh dev",
        "e2e:41": "bash scripts/e2e/run-version.sh 41",
        "e2e:42": "bash scripts/e2e/run-version.sh 42",
        "e2e:43": "bash scripts/e2e/run-version.sh 43",
        "e2e:dev": "bash scripts/e2e/run-version.sh dev",
        "e2e:validate": "bash scripts/e2e/validate.sh",
        "e2e:up": "bash scripts/e2e/up.sh",
        "e2e:down": "bash scripts/e2e/down.sh",
        "dev:docs": "pnpm --filter @dhis2-blocks/docs run dev",
        "build:docs": "pnpm --filter @dhis2-blocks/docs run build",
        "serve:docs": "pnpm --filter @dhis2-blocks/docs run serve",
        "docs:up": "bash scripts/docs/up.sh 42",
        "docs:up:41": "bash scripts/docs/up.sh 41",
        "docs:up:43": "bash scripts/docs/up.sh 43",
        "docs:up:dev": "bash scripts/docs/up.sh dev",
        "docs:down": "bash scripts/docs/down.sh",
        "docs:reset": "bash scripts/docs/reset.sh 42",
        "docs:e2e": "bash scripts/docs/test-e2e.sh 42"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@oxlint/plugins": "1.79.0",
        "@playwright/test": "^1.62.1",
        "@types/node": "^22.0.0",
        "knip": "6.32.2",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "shadcn": "4.22.1",
        "turbo": "^2.10.10",
        "typescript": "^5.9.3",
        "zod": "^4.4.3"
    },
    "packageManager": "pnpm@10.13.1"
}

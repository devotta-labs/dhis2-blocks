{
    "compilerOptions": {
        "strict": true,
        "skipLibCheck": true,
        "allowJs": false,
        "jsx": "react",
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "type-tests/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}

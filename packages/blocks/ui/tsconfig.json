{
    "compilerOptions": {
        "strict": true,
        "skipLibCheck": true,
        "allowJs": false,
        "jsx": "react",
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "scripts/**/*.test.ts"]
}

    "compilerOptions": {
        "strict": true,
        "skipLibCheck": true,
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": ["*.ts"]
}

{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "useDefineForClassFields": true,
        "allowJs": true,
        "types": ["vite/client", "node"],
        "paths": {
            "@/registry/dhis2/ui/*": ["../../packages/blocks/ui/src/*"],
            "@/components/sidebar": [
                "../../packages/blocks/sidebar/src/index.ts"
            ],
            "@/components/context-selector": [
                "../../packages/blocks/context-selector/src/index.ts"
            ],
            "@/components/working-list": [
                "../../packages/blocks/working-list/src/index.ts"
            ]
        }
    },
    "include": [
        "src",
        "server",
        "vite.config.ts",
        "../../packages/blocks/context-selector/src/dhis2-ui-selector-bar.d.ts"
    ]
}

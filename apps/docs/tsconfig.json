{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "useDefineForClassFields": true,
        "allowJs": true,
        "types": ["vite/client", "node"]
    },
    "include": [
        "src",
        "server",
        "vite.config.ts",
        "../../packages/blocks/context-selector/src/dhis2-ui-selector-bar.d.ts"
    ]
}

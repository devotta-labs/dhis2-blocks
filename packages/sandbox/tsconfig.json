{
    "compilerOptions": {
        "strict": true,
        "skipLibCheck": true,
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": ["src/*.ts"]
}

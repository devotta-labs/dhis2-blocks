{
    "$schema": "https://turborepo.dev/schema.json",
    "cacheDir": ".turbo/cache",
    "globalDependencies": [
        "tsconfig*.json",
        "pnpm-workspace.yaml",
        "patches/**"
    ],
    "globalEnv": ["CI"],
    "tasks": {
        "transit": {
            "dependsOn": ["^transit"]
        },
        "build": {
            "dependsOn": ["^transit"],
            "env": [
                "NODE_ENV",
                "PUBLIC_URL",
                "DHIS2_BASE_URL",
                "REACT_APP_*",
                "VITE_*",
                "DOCS_*"
            ],
            "outputs": ["build/**", "dist/**", ".d2/**", "src/locales/**"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/registry/layout.ts"
            ]
        },
        "test": {
            "dependsOn": ["^transit"],
            "outputs": [],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/registry/layout.ts"
            ]
        },
        "typecheck": {
            "dependsOn": ["^transit"],
            "outputs": [],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/registry/layout.ts"
            ]
        },
        "lint": {
            "outputs": []
        },
        "//#typecheck:registry": {
            "inputs": ["tools/**", "package.json"],
            "outputs": []
        },
        "start": {
            "cache": false,
            "persistent": true
        },
        "deploy": {
            "dependsOn": ["build"],
            "cache": false
        },
        "@dhis2-blocks/docs#test": {
            "dependsOn": ["^transit"],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/tools/registry/layout.ts",
                "$TURBO_ROOT$/api/**"
            ],
            "outputs": []
        },
        "//#test:tools": {
            "inputs": [
                "tools/**",
                "scripts/**",
                ".github/**",
                "turbo.json",
                "package.json",
                "apps/*/package.json",
                "packages/*/package.json",
                "apps/*/tsconfig.json",
                "packages/registry/tsconfig.json"
            ],
            "outputs": []
        }
    }
}
